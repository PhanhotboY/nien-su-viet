ENV_PREFIX=billing

BILLING_SERVER_ENV=development

# ============================================================================
# Application Options (for Otel)
# ============================================================================
BILLING_SERVER_SERVICE_NAME=billing-service
BILLING_SERVER_VERSION=v2.25a8aa0

# ============================================================================
# GRPC Server Configuration
# ============================================================================
BILLING_GRPC_NAME=billing-grpc-server
BILLING_GRPC_PORT=8085
BILLING_GRPC_HOST=0.0.0.0
BILLING_GRPC_DEVELOPMENT=true

# ============================================================================
# Logging Configuration
# ============================================================================
# Levels: trace, debug, info, warn, error, fatal
BILLING_LOG_LEVEL=debug
BILLING_LOG_TYPE=0
BILLING_LOG_CALLER_ENABLED=false
BILLING_LOG_ENABLE_TRACING=true

# ============================================================================
# RabbitMQ Configuration
# ============================================================================
BILLING_RMQ_AUTOSTART=true
BILLING_RMQ_RECONNECTING=true
BILLING_RMQ_USERNAME=nsv_rmq_user
BILLING_RMQ_PASSWORD=secure_password
BILLING_RMQ_HOSTNAME=localhost
BILLING_RMQ_PORT=5672
BILLING_RMQ_HTTP_PORT=15672

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
BILLING_PG_HOST=localhost
BILLING_PG_PORT=5432
BILLING_PG_USERNAME=nsv_billing_user
BILLING_PG_PASSWORD=secure_password
BILLING_PG_DATABASE=nsv_billing_db
BILLING_PG_LOG_LEVEL=6
BILLING_PG_SSL_MODE=false

# ============================================================================
# Redis Configuration
# ============================================================================
BILLING_REDIS_HOST=localhost
BILLING_REDIS_PORT=6379
BILLING_REDIS_USERNAME=""
BILLING_REDIS_PASSWORD=""
BILLING_REDIS_DATABASE=0
BILLING_REDIS_POOL_SIZE=300
BILLING_REDIS_ENABLE_TRACING=true

# ============================================================================
# Metrics Configuration
# ============================================================================
BILLING_METRICS_USE_STDOUT=false
BILLING_METRICS_INSTRUMENTATION_NAME=github.com/open-telemetry/opentelemetry-go
BILLING_METRICS_ENABLE_HOST_METRICS=true
BILLING_METRICS_USE_OTLP=true
BILLING_METRICS_OTLP_PROVIDER_ENDPOINT=127.0.0.1:4317

# ============================================================================
# Tracing Configuration
# ============================================================================
BILLING_TRACING_ENABLED=true
BILLING_TRACING_INSTRUMENTATION_NAME=github.com/open-telemetry/opentelemetry-go
BILLING_TRACING_ALWAYS_ON_SAMPLER=true
BILLING_TRACING_USE_STDOUT=false
BILLING_TRACING_USE_OTLP=true
BILLING_TRACING_OTLP_PROVIDER_ENDPOINT=127.0.0.1:4317

# ============================================================================
# ZaloPay Configuration
# ============================================================================
BILLING_ZALOPAY_APP_ID=2553
BILLING_ZALOPAY_APP_USER=ZaloPayDemo
BILLING_ZALOPAY_KEY1=PcY4iZIKFCIdgZvA6ueMcMHHUbRLYjPL
BILLING_ZALOPAY_KEY2=kLtgPl8HHhfvMuDHPwKfgfsY4Ydm9eIz
BILLING_ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
BILLING_ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
BILLING_ZALOPAY_CALLBACK_URL=https://thorn-repurpose-plot.ngrok-free.dev/api/v1/billing/zalopay/callback
BILLING_ZALOPAY_REDIRECT_URL=https://nien-su-viet.app/checkout/success
